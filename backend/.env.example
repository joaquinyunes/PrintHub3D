# MongoDB
MONGO_URI=mongodb://localhost:27017/global3d

# JWT
JWT_SECRET=your-secret-key-here
# Duración del access token. Recomendado 7d en producción (hay refresh token de 7d).
JWT_EXPIRES_IN=30d
# Dominio para las cookies de sesión httpOnly (ej: .tudominio.com). Vacío = host actual.
COOKIE_DOMAIN=

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# URL publica del backend (para notification_url de MercadoPago). Sin barra final.
API_PUBLIC_URL=http://localhost:5000
LOG_LEVEL=info
# Limite de requests por IP por minuto (API general)
RATE_LIMIT_MAX=150

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mercado Pago
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Panel MP > Webhooks). Obligatoria en produccion.
MP_WEBHOOK_SECRET=

# OpenAI
OPENAI_API_KEY=

# Redis (opcional; habilita la cola de notificaciones con reintentos)
REDIS_URL=

# WhatsApp vía Twilio (API oficial). Sin esto, las notificaciones se registran pero no se envían.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Número del dueño/taller para recibir avisos internos (formato +549...)
ADMIN_WHATSAPP=

# Verificación de email al registrarse. false (por defecto) = la cuenta queda activa al instante.
# Poné true solo si configuraste SMTP y creaste las páginas de verificación.
REQUIRE_EMAIL_VERIFICATION=false

# SMTP (verificación de email + recuperación de contraseña). Si SMTP_HOST está vacío, no se envían mails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Global 3D <noreply@global3d.com>"
